<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ToolTester.Presentation.Pages.ToolDeclaredCwesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ToolTester.Presentation.PageModels"
    x:DataType="vm:ToolDeclaredCwesPageModel"
    Title="Declared CWEs">

    <ScrollView>
        <VerticalStackLayout Padding="12" Spacing="12">

            <!-- Tool selector -->
            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                <Label Text="Tool:" VerticalOptions="Center" />
                <Picker
            ItemsSource="{Binding Tools}"
            ItemDisplayBinding="{Binding Name}"
            SelectedItem="{Binding SelectedTool}" />
                <Button Text="Refresh" Command="{Binding RefreshCommand}" />
            </HorizontalStackLayout>

            <!-- Editable declared CWE list -->
            <Frame Padding="10" Stroke="#D9D9D9">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Declared CWEs" FontAttributes="Bold" />

                    <CollectionView ItemsSource="{Binding DeclaredCoverages}" SelectionMode="None" HeightRequest="240">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="domain:ToolDeclaredCwe" xmlns:domain="clr-namespace:ToolTester.Domain.Entities;assembly=ToolTester.Domain">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Padding="6">
                                    <Label Grid.Column="0" Text="{Binding CweId}" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding CweId, StringFormat='CWE-{0}'}" VerticalOptions="Center" />
                                    <Button Grid.Column="2" Text="Remove" Command="{Binding BindingContext.RemoveDeclaredCweCommand, Source={x:Reference Name=ThisPage}}" CommandParameter="{Binding .}" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Add new declared CWE -->
                    <HorizontalStackLayout Spacing="8">
                        <Entry Placeholder="Enter CWE id (numeric)" Keyboard="Numeric" Text="{Binding NewCweIdText}" />
                        <Button Text="Add" Command="{Binding AddDeclaredCweCommand}" />
                    </HorizontalStackLayout>

                    <!-- Save changes -->
                    <HorizontalStackLayout Spacing="8" HorizontalOptions="End">
                        <Button Text="Save" Command="{Binding SaveCommand}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>