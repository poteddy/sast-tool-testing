<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="ToolTester.Presentation.Pages.ReportPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:pageModels="clr-namespace:ToolTester.Presentation.PageModels"
    x:DataType="pageModels:ReportPageModel"
    Title="Reports">

    <ScrollView>

        <VerticalStackLayout
            Padding="10"
            Spacing="12">

            <ActivityIndicator
                IsRunning="{Binding IsLoading}"
                IsVisible="{Binding IsLoading}"
                HorizontalOptions="Center" />

            <Label
                Text="{Binding ErrorMessage}"
                TextColor="Red"
                IsVisible="{Binding ErrorMessage}" />

            <Button
Text="Refresh"
Command="{Binding RefreshCommand}" />
            <!-- FALSE POSITIVES -->

            <Border
                Stroke="#D9D9D9"
                StrokeThickness="1"
                Padding="10">

                <VerticalStackLayout>

                    <Label
                        Text="False Positives"
                        FontAttributes="Bold"
                        FontSize="18" />

                    <lvc:CartesianChart
                        Series="{Binding FalsePositiveSeries}"
                        XAxes="{Binding FalsePositiveXAxes}"
                        YAxes="{Binding FalsePositiveYAxes}"
                        ZoomMode="X"
                        LegendPosition="Top"
                        TooltipPosition="Top"
                        HeightRequest="450" />

                </VerticalStackLayout>

            </Border>

            <!-- RELATED CWES -->
            <Picker
          Title="Relationship Filter"
          ItemsSource="{Binding AvailableRelationships}"
          SelectedItem="{Binding SelectedRelationship}" />

            <Border
                Stroke="#D9D9D9"
                StrokeThickness="1"
                Padding="10">

                <VerticalStackLayout>

                    <Label
                        Text="Related Findings"
                        FontAttributes="Bold"
                        FontSize="18" />

                    <lvc:CartesianChart
                        Series="{Binding RelatedFindingSeries}"
                        XAxes="{Binding RelatedFindingXAxes}"
                        YAxes="{Binding RelatedFindingYAxes}"
                        ZoomMode="Both"
                        LegendPosition="Top"
                        TooltipPosition="Top"
                        HeightRequest="450" />

                </VerticalStackLayout>

            </Border>

            <!-- FALSE NEGATIVE PARETO -->

            <CollectionView
                ItemsSource="{Binding ParetoCharts}"
                SelectionMode="None">

                <CollectionView.ItemTemplate>

                    <DataTemplate
                        x:DataType="pageModels:ParetoChartModel">

                        <Border
                            Stroke="#D9D9D9"
                            StrokeThickness="1"
                            Padding="10">

                            <VerticalStackLayout>

                                <Label
                                    Text="{Binding Title}"
                                    FontAttributes="Bold"
                                    FontSize="18" />

                                <lvc:CartesianChart
                                    Series="{Binding Series}"
                                    XAxes="{Binding XAxes}"
                                    YAxes="{Binding YAxes}"
                                    ZoomMode="X"
                                    LegendPosition="Top"
                                    TooltipPosition="Top"
                                    HeightRequest="500" />

                            </VerticalStackLayout>

                        </Border>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

            <!-- RELATIONSHIP MIX -->

            <Border
                Stroke="#D9D9D9"
                StrokeThickness="1"
                Padding="10">

                <VerticalStackLayout>

                    <Label
                        Text="Relationship Mix By Scanner"
                        FontAttributes="Bold"
                        FontSize="18" />

                    <lvc:CartesianChart
Series="{Binding RelationshipMixChartSeries}"
XAxes="{Binding RelationshipMixXAxes}"
YAxes="{Binding RelationshipMixYAxes}"
ZoomMode="X"
LegendPosition="Top"
TooltipPosition="Top"
HeightRequest="550" />

                </VerticalStackLayout>

            </Border>

            <!-- POLAR -->

            <Border
                Stroke="#D9D9D9"
                StrokeThickness="1"
                Padding="10">

                <VerticalStackLayout>

                    <Label
                        Text="Scanner CWE Distribution"
                        FontAttributes="Bold"
                        FontSize="18" />

                    <lvc:PolarChart
                        Series="{Binding PolarSeries}"
                        AngleAxes="{Binding PolarAngleAxes}"
                        RadiusAxes="{Binding PolarRadiusAxes}"
                        LegendPosition="Top"
                        TooltipPosition="Top"
                        HeightRequest="450" />

                </VerticalStackLayout>

            </Border>

            <Border
    IsVisible="{Binding HasMitreTop25Data}"
    Stroke="#D9D9D9"
    StrokeThickness="1"
    Padding="10"
    Margin="8,6">

                <VerticalStackLayout
        Spacing="6">

                    <Label
            Text="2025 MITRE CWE Top 25 - Juliet C/C++ Detection Rate"
            FontSize="18"
            FontAttributes="Bold"
            HorizontalTextAlignment="Center" />

                    <Label
            Text="Each line represents a scanner. Missing points indicate that the C/C++ benchmark has no opportunity for that CWE."
            FontSize="12"
            TextColor="Gray"
            HorizontalTextAlignment="Center" />

                    <lvc:CartesianChart
            Series="{Binding MitreTop25Series}"
            XAxes="{Binding MitreTop25XAxes}"
            YAxes="{Binding MitreTop25YAxes}"
            ZoomMode="X"
            LegendPosition="Top"
            TooltipPosition="Top"
            HeightRequest="550" />

                </VerticalStackLayout>

            </Border>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>