<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ToolTester.Presentation.Pages.ScansPage"
             Title="Scans">
    <VerticalStackLayout Padding="12" Spacing="10">
        <HorizontalStackLayout Spacing="8">
            <Button Text="Add" Command="{Binding AddCommand}" />
            <Button Text="Refresh" Command="{Binding RefreshCommand}" />
        </HorizontalStackLayout>

        <CollectionView ItemsSource="{Binding Scans}"
                    SelectionMode="Single"
                    SelectedItem="{Binding SelectedScan, Mode=TwoWay}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="8" Margin="4">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <Label Grid.Row="0" Grid.Column="0" Text="{Binding Name}" FontAttributes="Bold" />
                            <Label Grid.Row="1" Grid.Column="0" Text="{Binding Description}" LineBreakMode="TailTruncation" />
                            <HorizontalStackLayout Grid.RowSpan="2" Grid.Column="1" Spacing="6">
                                <Button Text="Edit"
                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditCommand}"
                        CommandParameter="{Binding .}" />
                                <Button Text="Delete"
                        BackgroundColor="Tomato"
                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteCommand}"
                        CommandParameter="{Binding .}" />
                            </HorizontalStackLayout>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentPage>