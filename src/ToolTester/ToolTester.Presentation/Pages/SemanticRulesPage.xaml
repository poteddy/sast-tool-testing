<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="ToolTester.Presentation.Pages.SemanticRulesPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Grid
        RowDefinitions="Auto,*"
        Padding="10">

        <!-- Editor -->

        <ScrollView Grid.Row="0">


            <VerticalStackLayout Spacing="10">

                <Label
                    FontAttributes="Bold"
                    FontSize="24"
                    Text="Semantic Rule Editor" />

                <Label
                    FontSize="12"
                    TextColor="Gray"
                    Text="Create and manage CWE relationship normalization rules." />

                <Border
                    Padding="15"
                    StrokeShape="RoundRectangle 8">

                    <VerticalStackLayout Spacing="10">

                        <Entry
                            Keyboard="Numeric"
                            Placeholder="Source CWE ID"
                            Text="{Binding CurrentRule.SourceCweId}" />

                        <Entry
                            Keyboard="Numeric"
                            Placeholder="Target CWE ID"
                            Text="{Binding CurrentRule.TargetCweId}" />

                        <Picker
                            Title="Relationship"
                            ItemsSource="{Binding RelationshipTypes}"
                            SelectedItem="{Binding CurrentRule.Relationship}" />

                        <Entry
                            Keyboard="Numeric"
                            Placeholder="Confidence Score (0-1000)"
                            Text="{Binding CurrentRule.Score}" />

                        <Editor
                            AutoSize="TextChanges"
                            HeightRequest="120"
                            Placeholder="Rationale"
                            Text="{Binding CurrentRule.Rationale}" />

                        <Entry
                            Placeholder="Evidence Reference"
                            Text="{Binding CurrentRule.EvidenceReference}" />

                        <HorizontalStackLayout>

                            <Label
                                VerticalOptions="Center"
                                Text="Bidirectional" />

                            <Switch
                                IsToggled="{Binding CurrentRule.Bidirectional}" />

                        </HorizontalStackLayout>

                        <Label
                            Text="{Binding ValidationMessage}"
                            TextColor="Red" />

                        <HorizontalStackLayout
                            HorizontalOptions="Center"
                            Spacing="10">

                            <Button
                                Command="{Binding NewRuleCommand}"
                                Text="New" />

                            <Button
                                Command="{Binding SaveRuleCommand}"
                                Text="Save" />

                            <Button
                                Command="{Binding ImportRulesCommand}"
                                Text="Import" />
                            <Button
                                Command="{Binding ExportRulesCommand}"
                                Text="Export" />
                            
                            <Button
                                Command="{Binding CancelEditCommand}"
                                Text="Cancel" />

                        </HorizontalStackLayout>

                    </VerticalStackLayout>

                </Border>

            </VerticalStackLayout>

        </ScrollView>

        <!-- Rules List -->

        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding Rules}"
            Margin="0,10,0,0">

            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Border
                        Padding="10"
                        Margin="0,0,0,8"
                        StrokeShape="RoundRectangle 8">

                        <VerticalStackLayout Spacing="4">

                            <Label
                                FontAttributes="Bold"
                                FontSize="18"
                                Text="{Binding SourceCweId, StringFormat='CWE-{0}'}" />

                            <Label
                                Text="{Binding TargetCweId, StringFormat='→ CWE-{0}'}" />

                            <Label
                                FontAttributes="Italic"
                                Text="{Binding Relationship}" />

                            <Label
                                Text="{Binding Score, StringFormat='Confidence: {0}'}" />

                            <Label
                                LineBreakMode="TailTruncation"
                                MaxLines="2"
                                Text="{Binding Rationale}" />

                            <Label
                                FontSize="12"
                                TextColor="Gray"
                                Text="{Binding EvidenceReference}" />

                            <HorizontalStackLayout
                                Spacing="5">

                                <Label Text="Bidirectional:" />

                                <Label
                                    Text="{Binding Bidirectional}" />

                            </HorizontalStackLayout>

                            <HorizontalStackLayout
                                HorizontalOptions="End"
                                Spacing="10">

                                <Button
    Text="Edit"
    Command="{Binding Source={x:Reference PageRoot},
                      Path=BindingContext.EditRuleCommand}"
    CommandParameter="{Binding .}" />

                                <Button
                                    BackgroundColor="IndianRed"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteRuleCommand}"
                                    CommandParameter="{Binding}"
                                    Text="Delete"
                                    TextColor="White" />

                            </HorizontalStackLayout>

                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>