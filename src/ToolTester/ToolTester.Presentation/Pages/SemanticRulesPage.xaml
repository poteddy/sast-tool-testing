<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="ToolTester.Presentation.Pages.SemanticRulesPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Grid
        Padding="16"
        ColumnDefinitions="3*,2*"
        RowDefinitions="Auto,*"
        ColumnSpacing="16"
        RowSpacing="12">

        <!-- Header -->
        <VerticalStackLayout
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Spacing="4">

            <Label
                FontAttributes="Bold"
                FontSize="24"
                Text="Semantic Rules" />

            <Label
                FontSize="13"
                TextColor="Gray"
                Text="Manage CWE normalization rules — select a rule to edit or create a new one." />

        </VerticalStackLayout>

        <!-- LEFT PANEL -->
        <Grid
            Grid.Row="1"
            Grid.Column="0"
            RowDefinitions="Auto,*"
            RowSpacing="12">

            <!-- Search / Actions -->
            <Grid
                Grid.Row="0"
                ColumnDefinitions="*,Auto,Auto"
                ColumnSpacing="8">

                <SearchBar
    x:Name="SearchBar"
    Grid.Column="0"
    Placeholder="Search by CWE, relationship, scanner id..."
    Text="{Binding SearchText, Mode=TwoWay}" />

                <Button
                    Grid.Column="1"
                    Text="Import"
                    Command="{Binding ImportRulesCommand}" />

                <Button
                    Grid.Column="2"
                    Text="Export"
                    Command="{Binding ExportRulesCommand}" />

            </Grid>

            <!-- Rule List -->
            <CollectionView
                Grid.Row="1"
                ItemsSource="{Binding Rules}"
                SelectionMode="Single"
                SelectedItem="{Binding SelectedRule, Mode=TwoWay}"
                VerticalOptions="FillAndExpand">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout
                        Orientation="Vertical"
                        ItemSpacing="8" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Border
                            Padding="12"
                            Stroke="#DDDDDD"
                            BackgroundColor="{AppThemeBinding Light=#F9F9F9, Dark=#1E1E1E}">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>

                            <Grid
                                RowDefinitions="Auto,Auto,Auto"
                                RowSpacing="8">

                                <!-- Row 1 -->
                                <Grid ColumnDefinitions="*,Auto">

                                    <HorizontalStackLayout
                                        Grid.Column="0"
                                        Spacing="8"
                                        VerticalOptions="Center">

                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="16"
                                            Text="{Binding SourceCweId, StringFormat='CWE-{0}'}" />

                                        <Label
                                            FontSize="16"
                                            Text="➜"
                                            TextColor="Gray" />

                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="16"
                                            Text="{Binding TargetCweId, StringFormat='CWE-{0}'}" />

                                    </HorizontalStackLayout>

                                    <HorizontalStackLayout
                                        Grid.Column="1"
                                        Spacing="6">

                                        <Button
                                            Text="Edit"
                                            FontSize="12"
                                            Padding="12,4"
                                            Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.EditRuleCommand}"
                                            CommandParameter="{Binding .}" />

                                        <Button
                                            Text="Delete"
                                            FontSize="12"
                                            Padding="12,4"
                                            BackgroundColor="IndianRed"
                                            TextColor="White"
                                            Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.DeleteRuleCommand}"
                                            CommandParameter="{Binding .}" />

                                    </HorizontalStackLayout>

                                </Grid>

                                <!-- Row 2 -->
                                <HorizontalStackLayout
                                    Grid.Row="1"
                                    Spacing="12">

                                    <Label
                                        FontSize="12"
                                        FontAttributes="Italic"
                                        Text="{Binding Relationship}"
                                        TextColor="DodgerBlue" />

                                    <Label
                                        FontSize="12"
                                        Text="{Binding Score, StringFormat='Conf: {0}'}"
                                        TextColor="Gray" />

                                </HorizontalStackLayout>

                                <!-- Row 3 -->
                                <Grid
                                    Grid.Row="2"
                                    ColumnDefinitions="*,Auto,Auto,Auto"
                                    ColumnSpacing="12">

                                    <Label
                                        Grid.Column="0"
                                        FontSize="11"
                                        TextColor="Gray"
                                        Text="{Binding EvidenceReference}"
                                        MaxLines="1"
                                        LineBreakMode="TailTruncation" />

                                    <Label
                                        Grid.Column="1"
                                        FontSize="11"
                                        FontAttributes="Bold"
                                        TextColor="Gray"
                                        Text="{Binding ScannerRuleId}" />

                                    <Label
                                        Grid.Column="2"
                                        FontSize="11"
                                        TextColor="Gray"
                                        Text="{Binding ProgrammingLanguage}" />

                                    <Label
                                        Grid.Column="3"
                                        FontSize="11"
                                        TextColor="Gray"
                                        Text="{Binding Version, StringFormat='v{0}'}" />

                                </Grid>

                            </Grid>

                        </Border>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

        </Grid>

        <!-- RIGHT PANEL -->
        <ScrollView
            Grid.Row="1"
            Grid.Column="1">

            <Border
                Padding="16"
                Stroke="#D6D6D6"
                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#252525}">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="14">

                    <Label
                        FontAttributes="Bold"
                        FontSize="18"
                        Text="Rule Editor" />

                    <!-- CWEs -->
                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="8">

                        <VerticalStackLayout
                            Grid.Column="0"
                            Spacing="2">

                            <Label
                                Text="Source CWE"
                                FontSize="11"
                                FontAttributes="Bold"
                                TextColor="Gray" />

                            <Entry
                                Keyboard="Numeric"
                                Placeholder="79"
                                Text="{Binding CurrentRule.SourceCweId}" />

                        </VerticalStackLayout>

                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="2">

                            <Label
                                Text="Target CWE"
                                FontSize="11"
                                FontAttributes="Bold"
                                TextColor="Gray" />

                            <Entry
                                Keyboard="Numeric"
                                Placeholder="20"
                                Text="{Binding CurrentRule.TargetCweId}" />

                        </VerticalStackLayout>

                    </Grid>

                    <!-- Relationship -->
                    <VerticalStackLayout Spacing="2">

                        <Label
                            Text="Relationship"
                            FontSize="11"
                            FontAttributes="Bold"
                            TextColor="Gray" />

                        <Picker
                            Title="Select Relationship"
                            ItemsSource="{Binding RelationshipTypes}"
                            SelectedItem="{Binding CurrentRule.Relationship}" />

                    </VerticalStackLayout>

                    <!-- Score + Scanner Rule -->
                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="8">

                        <VerticalStackLayout
                            Grid.Column="0"
                            Spacing="2">

                            <Label
                                Text="Confidence Score"
                                FontSize="11"
                                FontAttributes="Bold"
                                TextColor="Gray" />

                            <Entry
                                Keyboard="Numeric"
                                Placeholder="0-1000"
                                Text="{Binding CurrentRule.Score}" />

                        </VerticalStackLayout>

                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="2">

                            <Label
                                Text="Scanner Rule Id"
                                FontSize="11"
                                FontAttributes="Bold"
                                TextColor="Gray" />

                            <Entry
                                Placeholder="Optional"
                                Text="{Binding CurrentRule.ScannerRuleId}" />

                        </VerticalStackLayout>

                    </Grid>

                    <!-- Language + Version -->
                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="8">

                        <VerticalStackLayout
                            Grid.Column="0"
                            Spacing="2">

                            <Label
                                Text="Programming Language"
                                FontSize="11"
                                FontAttributes="Bold"
                                TextColor="Gray" />

                            <Entry
                                Placeholder="C#, Java, C++, etc."
                                Text="{Binding CurrentRule.ProgrammingLanguage}" />

                        </VerticalStackLayout>

                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="2">

                            <Label
                                Text="Version"
                                FontSize="11"
                                FontAttributes="Bold"
                                TextColor="Gray" />

                            <Entry
                                Placeholder="1.0"
                                Text="{Binding CurrentRule.Version}" />

                        </VerticalStackLayout>

                    </Grid>

                    <!-- Rationale -->
                    <VerticalStackLayout Spacing="2">

                        <Label
                            Text="Rationale"
                            FontSize="11"
                            FontAttributes="Bold"
                            TextColor="Gray" />

                        <Border
                            Padding="2"
                            Stroke="#CCCCCC">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="4" />
                            </Border.StrokeShape>

                            <Editor
                                HeightRequest="100"
                                AutoSize="TextChanges"
                                Placeholder="Reason for rule classification..."
                                Text="{Binding CurrentRule.Rationale}" />

                        </Border>

                    </VerticalStackLayout>

                    <!-- Evidence -->
                    <VerticalStackLayout Spacing="2">

                        <Label
                            Text="Evidence Reference"
                            FontSize="11"
                            FontAttributes="Bold"
                            TextColor="Gray" />

                        <Entry
                            Placeholder="Report, file, CWE documentation..."
                            Text="{Binding CurrentRule.EvidenceReference}" />

                    </VerticalStackLayout>

                    <!-- Flags -->
                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="16">

                        <HorizontalStackLayout
                            Grid.Column="0"
                            Spacing="6">

                            <Label
                                VerticalOptions="Center"
                                Text="Bidirectional" />

                            <Switch
                                IsToggled="{Binding CurrentRule.Bidirectional}" />

                        </HorizontalStackLayout>

                        <HorizontalStackLayout
                            Grid.Column="1"
                            Spacing="6">

                            <Label
                                VerticalOptions="Center"
                                Text="Enabled" />

                            <Switch
                                IsToggled="{Binding CurrentRule.Enabled}" />

                        </HorizontalStackLayout>

                    </Grid>

                    <!-- Rule Id -->
                    <Label
                        FontSize="11"
                        TextColor="Gray"
                        Text="{Binding CurrentRule.Id, StringFormat='Rule Id: {0}'}" />

                    <!-- Validation -->
                    <Label
                        Text="{Binding ValidationMessage}"
                        TextColor="Red" />

                    <BoxView
                        HeightRequest="1"
                        Color="#DDDDDD" />

                    <!-- Buttons -->
                    <HorizontalStackLayout
                        HorizontalOptions="End"
                        Spacing="8">

                        <Button
                            Text="New"
                            Command="{Binding NewRuleCommand}" />

                        <Button
                            Text="Save"
                            Command="{Binding SaveRuleCommand}" />

                        <Button
                            Text="Cancel"
                            Command="{Binding CancelEditCommand}" />

                    </HorizontalStackLayout>

                </VerticalStackLayout>

            </Border>

        </ScrollView>

    </Grid>

</ContentPage>